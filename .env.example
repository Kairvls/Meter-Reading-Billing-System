# Database provider: firebase | supabase
DATABASE_PROVIDER=firebase

# Firebase Web App (Project settings → Your apps → SDK setup)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Project settings → Service accounts → Generate new private key)
# Paste private_key as one line, keep \n escapes from the JSON file
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Supabase (Dashboard → Project Settings → API)
# Used when DATABASE_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Run supabase/schema.sql in the Supabase SQL Editor before first use.

# Auth
AUTH_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Offline SQLite copy (works with both Firebase and Supabase)
# Local mirror of meter records / deleted / activity logs for quota or offline use.
# Default path: data/offline-copy.sqlite (gitignored)
# OFFLINE_DB_PATH=data/offline-copy.sqlite
